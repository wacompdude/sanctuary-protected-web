# Supabase public configuration only — never put the service-role key here.
# Project settings > API: https://app.supabase.com/project/_/settings/api
#
# IMPORTANT: Use the Project URL only — do NOT include /rest/v1
# Correct:   https://your-project-ref.supabase.co
# Incorrect: https://your-project-ref.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Prefer the legacy JWT anon key with @supabase/ssr:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Or the publishable key (also supported):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Canonical production URL (no trailing slash). Required in Vercel production so
# auth confirmation / invitation links never point at localhost.
# Also set Supabase Dashboard → Authentication → URL Configuration:
#   Site URL = this same production origin
#   Redirect URLs include https://your-domain.com/auth/confirm**
# NEXT_PUBLIC_APP_URL=https://app.sanctuaryprotected.com

# -----------------------------------------------------------------------------
# Email notifications (Resend) — server-side only
# Do NOT use NEXT_PUBLIC_ for any of these values.
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER_API_KEY=
# Optional alias also accepted by the Resend adapter:
# RESEND_API_KEY=

# Verified outbound domain (all From addresses must use this domain)
# EMAIL_DOMAIN=sanctuaryprotected.com

# Purpose-specific From addresses (controlled sender registry)
# EMAIL_FROM_ALERTS=alerts@sanctuaryprotected.com
# EMAIL_FROM_NO_REPLY=no-reply@sanctuaryprotected.com
# EMAIL_FROM_INFO=info@sanctuaryprotected.com
# EMAIL_FROM_EMERGENCY=emergency@sanctuaryprotected.com
# EMAIL_FROM_INCIDENTS=incidents@sanctuaryprotected.com
# EMAIL_FROM_ACCESS=access@sanctuaryprotected.com
# EMAIL_FROM_SUPPORT=support@sanctuaryprotected.com
# EMAIL_FROM_BILLING=billing@sanctuaryprotected.com
# EMAIL_FROM_HARDWARE=hardware@sanctuaryprotected.com

# Reply-to mailboxes (require real mailbox or forwarding outside Resend)
# EMAIL_REPLY_TO_DEFAULT=support@sanctuaryprotected.com
# EMAIL_REPLY_TO_SUPPORT=support@sanctuaryprotected.com
# EMAIL_REPLY_TO_BILLING=billing@sanctuaryprotected.com

# Temporary compatibility (deprecated): if EMAIL_FROM_ALERTS is unset, alerts may
# fall back to EMAIL_FROM_ADDRESS. Prefer the category-specific variables above.
# EMAIL_FROM_ADDRESS=alerts@sanctuaryprotected.com
# EMAIL_REPLY_TO=support@sanctuaryprotected.com

# Optional invitation reply-to override (otherwise access sender reply-to is used)
# MEMBERSHIP_INVITE_REPLY_TO=support@sanctuaryprotected.com

# Secure dispatcher + webhook verification (server-side only)
# NOTIFICATION_DISPATCH_SECRET=
# Resend webhook signing secret (whsec_...). Also accepted as NOTIFICATION_WEBHOOK_SECRET.
# RESEND_WEBHOOK_SECRET=
# NOTIFICATION_WEBHOOK_SECRET=
# Webhook URL: https://<your-app>/api/notifications/webhooks/resend
# CRON_SECRET=
# APP_BASE_URL=http://localhost:3000
#
# Local development without Resend:
# EMAIL_PROVIDER=console

# -----------------------------------------------------------------------------
# Expo push notifications (mobile locked-phone alerts)
# Optional. Expo accepts unauthenticated sends with rate limits.
# Create a token at https://expo.dev/settings/access-tokens
# EXPO_ACCESS_TOKEN=
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Login MFA (email code + optional Text/SMS backup)
# Do NOT use NEXT_PUBLIC_ for these values.
# Apply supabase/migrations/087_user_mfa_security.sql before enabling in prod.
# MFA policy / reauth: also apply 090, 092, and 093 (do not recreate 090).
# -----------------------------------------------------------------------------
# Emergency kill switch only. Do not use this for routine testing.
# Super Admins toggle MFA from Platform → Security. That database
# setting does not delete enrollments or trusted devices.
# Missing, empty, or any value other than false keeps MFA capability ON.
# Only the explicit value false (any case) enables the emergency bypass.
# MFA_LOGIN_ENABLED=true
# Three independent production secrets. Do not reuse CRON_SECRET,
# SUPABASE_SERVICE_ROLE_KEY, or each other. Generate each separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# MFA_SESSION_SECRET signs web cookies and mobile MFA tokens.
# Changing it invalidates current MFA sessions until users re-verify.
# MFA_SESSION_SECRET=
# MFA_CODE_PEPPER hashes one-time codes. Required in production.
# Changing it invalidates in-flight ~10-minute OTP challenges only.
# MFA_CODE_PEPPER=
# TRUSTED_DEVICE_DURATION_DAYS=30
# TRUSTED_DEVICE_PEPPER hashes trusted-device tokens. Required in production.
# Changing it invalidates remembered devices until users complete MFA again.
# TRUSTED_DEVICE_PEPPER=
# Text/SMS backup provider: none | console | bird
# Use bird when BIRD_SMS_API_KEY and BIRD_SMS_FROM are set. Use console only
# for local development that should not send real messages.
# Application notification SMS: console | bird | none
# Local/dev defaults to console (no live SMS). Set SMS_PROVIDER=bird only for
# a controlled live test. Production uses Bird when BIRD_SMS_API_KEY is set.
# SMS_PROVIDER=console
# MFA_SMS_PROVIDER=bird
# BIRD_SMS_API_KEY=
# Toll-free sender used for application SMS (E.164). Example: +18445193919
# Voice number included in HELP auto-replies. Defaults to BIRD_SMS_FROM.
# SUPPORT_PHONE=+18445193919
# BIRD_SMS_FROM=
# BIRD_FROM_NUMBER=
# Standard Webhooks signing secret from Bird Developers → Webhooks (whsec_...).
# Required for POST /api/notifications/webhooks/bird. Requests fail closed without it.
# BIRD_WEBHOOK_SECRET=
# Webhook URL: https://<your-app>/api/notifications/webhooks/bird
# Enabled SMS destination regions. US, CA, and PR by default. Do not add VI
# unless this Bird toll-free sender is confirmed to reach the U.S. Virgin Islands.
# SMS_ENABLED_REGIONS=US,CA,PR
# Toll-free HELP is typically answered by Bird. Leave unset unless this app
# must send a second HELP reply. Set to true only if Bird is not auto-replying.
# SMS_HELP_REPLY=


# -----------------------------------------------------------------------------
# Billing provider (Phase 4B — Stripe server foundation)
# Do NOT use NEXT_PUBLIC_ for provider secrets. Never commit real keys.
# -----------------------------------------------------------------------------
# none | unconfigured | stripe
# BILLING_PROVIDER=unconfigured
# Webhook URL shape: https://<your-app>/api/billing/webhooks/stripe
# Server-only Stripe secrets (leave empty until intentionally configuring Stripe):
# STRIPE_SECRET_KEY=
# Required for capabilities.webhooks=true and signature verification (Dashboard webhook not configured in 4B-4):
# STRIPE_WEBHOOK_SECRET=
# Optional (not required for Phase 4B-1 server foundation):
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PORTAL_CONFIGURATION_ID=
# EMAIL_FROM_BILLING=

# DO NOT add SUPABASE_SERVICE_ROLE_KEY to any NEXT_PUBLIC_ variable.
# The service-role key must never ship to the browser.
# Required on the server for Team → Add member AND notification email delivery rows.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Platform super-admin bootstrap (temporary, server-only)
# DO NOT use NEXT_PUBLIC_. Never commit real passwords.
# Disabled by default. Run only: npm run bootstrap:super-admin
# Do NOT pass the password as a CLI argument.
# Approved email only: repus_admin@sanctuaryprotected.com
# After success: set ENABLED=false, clear PASSWORD, change password, enroll MFA.
# -----------------------------------------------------------------------------
# SUPER_ADMIN_BOOTSTRAP_EMAIL=
# SUPER_ADMIN_BOOTSTRAP_PASSWORD=
# SUPER_ADMIN_BOOTSTRAP_ENABLED=false
